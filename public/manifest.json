{
  "id": "win11-webos",
  "name": "Windows 11 WebOS — the Windows 11 desktop in your browser",
  "short_name": "Win11 WebOS",
  "description": "A free, open-source recreation of the Windows 11 desktop that runs entirely in the browser: Start menu, File Explorer, Microsoft Edge, Notepad, Paint, Photos, Store, Office, Solitaire and a local AI. No install, no server, no telemetry.",
